# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and the anon (public) key — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Auth (Google SSO via Supabase) ───────────────────────────────────────────
# Configure Google as an auth provider in Supabase dashboard → Authentication.
# https://supabase.com/docs/guides/auth/social-login/auth-google
# Restrict sign-ups to your team via the auth.users hook or a domain allowlist.
ALLOWED_EMAIL_DOMAIN=mxigroup.com

# ─── Google Sheets / Drive (service account) ──────────────────────────────────
# Create a service account in Google Cloud Console, give it the Sheets +
# Drive APIs, share the target Sheet/Drive folder with the service account
# email. Paste the JSON key here as a single-line JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Google Sheet ID to sync into (the long string in the URL).
GOOGLE_SHEETS_TRACKER_ID=
# Google Drive folder ID for screenshot uploads / PDF report storage.
GOOGLE_DRIVE_FOLDER_ID=

# ─── Platform APIs ────────────────────────────────────────────────────────────
# YouTube Data API v3 key. Quota: 10k units/day default. Quota cost per request
# in docs/PLATFORMS.md. Sufficient for hundreds of post refreshes daily.
YOUTUBE_API_KEY=

# Meta (Instagram + Facebook) Graph API. Requires a Meta Developer app,
# Instagram Login or Instagram Graph API, and per-creator OAuth tokens stored
# in creator_platform_accounts. See docs/PLATFORMS.md.
META_APP_ID=
META_APP_SECRET=

# TikTok — Display API requires creator OAuth (per-creator tokens). The
# Research API requires academic approval and is not suitable for MVP.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X / Twitter API v2 — paid Basic tier ($200/mo) needed for post metrics at any
# meaningful volume. See docs/PLATFORMS.md for the cost/coverage trade-off.
X_BEARER_TOKEN=

# ─── Optional: Click Analytic (creator analytics aggregator) ──────────────────
# If you have a subscription, this can stand in for some per-platform APIs.
CLICK_ANALYTIC_API_KEY=

# ─── Optional: ScraperAPI (public-page fallback) ──────────────────────────────
# Only used for publicly accessible pages where ToS permits. Last-resort
# fallback when no API/creator-auth path is available.
SCRAPERAPI_KEY=

# ─── Cron secret (Vercel Cron / GitHub Actions / etc.) ────────────────────────
# A shared secret the cron caller passes in the Authorization header so the
# /api/refresh endpoint can verify the request is from your scheduler.
CRON_SECRET=
